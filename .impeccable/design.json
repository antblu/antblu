      "html": "<nav class=\"ds-nav\" aria-label=\"Site navigation\"><a href=\"#experience\">Experience</a><a href=\"#projects\">Projects</a><a href=\"#services\" aria-current=\"page\">Services</a><a href=\"#contact\">Contact</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:clamp(.8rem,2vw,1.7rem);padding-inline:16px;background:var(--svc-bg,#f3f7fb);border-bottom:1px solid var(--svc-line,#d4dfeb);font:500 .875rem/1.65 var(--svc-body-font,Inter,system-ui,sans-serif)}.ds-nav a{display:flex;align-items:center;min-height:44px;color:var(--svc-muted,#4b6077);text-decoration:none}.ds-nav a:is(:hover,[aria-current=\"page\"]){color:var(--svc-link,#20558a);text-decoration:underline;text-underline-offset:.2em}.ds-nav a:focus-visible{outline:3px solid var(--svc-accent,#2473df);outline-offset:4px}"
    },
    {
      "name": "Standard text field",
      "kind": "input",
      "refersTo": "field-standard",
      "description": "Use a visible label and a native form control.",
      "html": "<label class=\"ds-field\">Email<input class=\"ds-input\" type=\"email\" placeholder=\"you@example.com\" autocomplete=\"email\"></label>",
      "css": ".ds-field{display:grid;gap:.3rem;color:var(--svc-ink,#132b48);font:650 .94rem/1.65 var(--svc-body-font,Inter,system-ui,sans-serif)}.ds-input{box-sizing:border-box;width:100%;min-height:44px;min-width:0;padding:.54rem .6rem;border:1px solid var(--svc-line,#d4dfeb);border-radius:8px;background:var(--svc-bg,#f3f7fb);color:inherit;font:inherit;font-size:1rem}.ds-input:focus-visible{outline:3px solid var(--svc-accent,#2473df);outline-offset:4px}"
    },
    {
      "name": "Experience skill tag",
      "kind": "chip",
      "refersTo": "tag-resume",
      "description": "Identify a tool or skill in an experience entry.",
      "html": "<span class=\"ds-tag\">Kubernetes</span>",
      "css": ".ds-tag{display:inline-block;border:1px solid var(--resume-line,#435a7138);border-radius:999px;background:var(--svc-bg,#f3f7fb);color:var(--svc-muted,#4b6077);padding:3px 10px;font:400 13px/1.5 var(--svc-body-font,Inter,system-ui,sans-serif)}:host-context([data-theme=\"dark\"]) .ds-tag{border-color:var(--resume-line,#a9bbce38)}"
    },
    {
      "name": "Consulting service card",
      "kind": "card",
      "refersTo": "card-services",
      "description": "Group a service title, summary, and link on a solid panel.",
      "html": "<article class=\"ds-service\"><h3>Open-Source Infrastructure</h3><p>Access controls, monitoring, and backups for open-source deployments.</p><a href=\"#infrastructure\">Explore Infrastructure</a></article>",
      "css": ".ds-service{display:flex;flex-direction:column;align-items:flex-start;gap:.65rem;padding:clamp(1rem,2.7vw,1.65rem);border:1px solid var(--svc-line,#d4dfeb);border-radius:13px;background:var(--svc-surface,#fff);color:var(--svc-ink,#132b48);font:400 .94rem/1.65 var(--svc-body-font,Inter,system-ui,sans-serif)}.ds-service h3{margin:0;font:750 1.18rem/1.14 var(--svc-heading,\"Plus Jakarta Sans\",system-ui,sans-serif);letter-spacing:-.033em}.ds-service p{margin:0;color:var(--svc-muted,#4b6077)}.ds-service a{margin-top:auto;color:var(--svc-link,#20558a);text-underline-offset:.2em}.ds-service a:focus-visible{outline:3px solid var(--svc-accent,#2473df);outline-offset:4px}"
    },
    {
      "name": "Project carousel card",
      "kind": "card",
      "refersTo": "card-project",
      "description": "Frame project artwork above the description and detail action.",
      "html": "<article class=\"ds-project\"><div class=\"ds-art\" aria-hidden=\"true\"><svg width=\"88\" height=\"72\" viewBox=\"0 0 88 72\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"30\" y=\"4\" width=\"28\" height=\"22\" rx=\"6\"/><rect x=\"4\" y=\"46\" width=\"26\" height=\"22\" rx=\"6\"/><rect x=\"58\" y=\"46\" width=\"26\" height=\"22\" rx=\"6\"/><path d=\"M44 26v10M17 46V36h54v10\"/></svg></div><div class=\"ds-copy\"><span class=\"ds-category\">INFRASTRUCTURE</span><h3>Antalos</h3><p>Kubernetes infrastructure and GitOps deployments.</p><button class=\"ds-project-link\" type=\"button\">VIEW DETAILS</button></div></article>",
      "css": ".ds-project{box-sizing:border-box;display:grid;align-content:end;min-height:370px;width:min(340px,100%);overflow:hidden;border-radius:12px;background:#070d16;color:#fff;box-shadow:0 18px 50px #0005;font:400 15px/1.6 var(--svc-body-font,Inter,system-ui,sans-serif)}.ds-art{display:grid;min-height:160px;place-items:center;background:radial-gradient(ellipse at 50% 0%,#3488ff50,transparent 85%);color:var(--brand-bright,#62a5ff)}.ds-copy{padding:24px 16px}.ds-copy h3{margin:.15em 0;font:700 23px/1.3 var(--svc-heading,\"Plus Jakarta Sans\",system-ui,sans-serif);letter-spacing:1px}.ds-copy p{margin:0 0 12px;color:#dbe6f2}.ds-category{color:#b7d8ff;font-size:12px;letter-spacing:1px}.ds-project-link{min-height:44px;padding:8px 10px;border:0;border-inline:2px solid #62a5ff;background:transparent;color:#d4e8ff;cursor:pointer;font:700 12px/1.5 var(--svc-heading,\"Plus Jakarta Sans\",system-ui,sans-serif);letter-spacing:1px}.ds-project-link:hover{background:#62a5ff;color:#070d16}.ds-project-link:focus-visible{outline:3px solid #62a5ff;outline-offset:4px}@media(max-width:700px){.ds-project{min-height:360px}.ds-copy{padding:22px 16px}.ds-copy h3{font-size:22px}}"
    }
  ],
  "narrative": {
    "northStar": "Systems, services, automation",
    "overview": "The portfolio pairs Anthony’s portrait and blue skies with evidence from his systems work. Landscape photography gives the homepage its rhythm. Project artwork, rack photos, topology diagrams, and service logos show visitors what he built and how the pieces fit.\n\nThe consulting pages share the blue palette and site navigation. They use solid panels, diagrams, and labeled controls so visitors can compare services and work through estimates. The Emiliany case study uses the store’s olive and ivory palette and its own photography.",
    "keyCharacteristics": [
      "Blue-gray surfaces and a persistent light/dark theme.",
      "Photo-backed portfolio sections with solid reading surfaces where the content needs them.",
      "Color and motion on the hero, project artwork, and inventory illustrations."
    ],
    "dos": [
      "Do use the shared theme variables for new consulting pages and check the page in both themes at 320px.",
      "Do keep text readable against a solid panel or a theme-aware photo overlay.",
      "Do limit the Emiliany colors and Georgia headline to that case study.",
      "Do keep visible keyboard focus and preserve text labels when a control has a decorative effect.",
      "Do keep project and inventory details available through their text and actions, including in reduced motion."
    ]
  }
}
